# Supabase credentials (public — safe to ship; RLS enforces access).
# Copy this file to `.env` and fill in your project's values.
# Find them in the Supabase dashboard → Project Settings → API.
# NEVER put the service-role key here or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
